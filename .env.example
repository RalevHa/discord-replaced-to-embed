# Copy to .env and fill in. `npm start` loads this automatically (node --env-file=.env).

# Required: your Discord bot token.
DISCORD_BOT_TOKEN=

# Optional: comma-separated server (guild) IDs the bot acts in. Empty = all servers.
ALLOWED_GUILD_IDS=

# Optional: health-check HTTP port. Defaults to 3000; Render sets this automatically.
PORT=3000

# Optional: Facebook posts get a native embed built from scraped Open Graph data
# (no self-hosted proxy or credentials needed). Set to "false" to disable, e.g. if
# Facebook starts blocking your server's IP. Defaults to enabled.
FACEBOOK_EMBED_ENABLED=true

# Optional: public base URL this bot's HTTP server is reachable at (e.g. a
# Cloudflare Tunnel hostname pointed at this machine), used only for Facebook
# Reel/video links. Lets Discord's own unfurler render a playable video via
# /fb/<encoded-url> instead of posting Facebook's raw (often short-lived,
# signed) CDN video URL directly. Leave blank to fall back to the raw URL.
FACEBOOK_PROXY_BASE_URL=

# Optional: Facebook's own lookaside video endpoint 500s for some Reels (Facebook-side
# issue, not fixable here). Default (false/unset) verifies the video URL first and
# falls back to an image-only embed rather than post a dead video link. Set to "true"
# to post it unverified anyway — more videos posted, some won't actually play.
FACEBOOK_TRUST_UNVERIFIED_VIDEO=false

# Optional: Cookie header value from a logged-in Facebook session (use a throwaway
# account, not your main one — scraping at bot volume risks a checkpoint/ban). When
# set, posts are fetched as that browser session instead of as Facebook's own crawler,
# which sees the real page and gets working video links more often. Leave blank to
# keep using the crawler UA (no login, no ban risk, but weaker video extraction).
# Get it: log into facebook.com as the throwaway account, open DevTools > Network,
# reload, click any facebook.com request, copy the "cookie" request header value.
FACEBOOK_COOKIE=

# Optional: Upstash Redis REST credentials. Both required for /toggle and /stats
# to persist across restarts. Leave blank to use in-memory state.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Cross-channel spam (hijacked-account) detection ---
# Detects one member posting the SAME text across many channels in a few seconds,
# then deletes those messages and times the member out.
# Requires the bot to have "Moderate Members" and "Manage Messages" permissions.

# Set to "false" to disable detection entirely. Defaults to enabled.
SPAM_DETECTION_ENABLED=true

# How many distinct channels the same text must hit to trip detection. Default 3.
SPAM_CHANNEL_THRESHOLD=3

# Sliding time window in seconds. Default 15.
SPAM_WINDOW_SECONDS=15

# How long to time the member out, in minutes. Default 10.
SPAM_TIMEOUT_MINUTES=10

# Optional: channel ID where moderation alerts are posted. Empty = console only.
MOD_LOG_CHANNEL_ID=

# Optional: comma-separated role IDs exempt from spam detection.
SPAM_TRUSTED_ROLE_IDS=

# Optional: comma-separated channel IDs to skip (e.g. cross-posted announcements).
SPAM_IGNORED_CHANNEL_IDS=

# --- Admin web panel (see README's "Admin panel" section) ---
# Optional: set this to enable the panel at /admin (login, guild settings,
# .env editor, deploy trigger). Leave blank to disable it entirely (404s).
ADMIN_PASSWORD=
# Required whenever ADMIN_PASSWORD is set — signs the panel's session cookie.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Optional: the name pm2 knows this process by (matches `pm2 restart <name>` in
# scripts/auto-deploy.ps1). Only matters if you registered it under a different
# name. Defaults to "discord-bot".
PM2_PROCESS_NAME=
# Optional: enables passkey login (a 2nd factor on top of ADMIN_PASSWORD — add
# one from the "Passkeys" card on the dashboard, and every login after that
# needs both the password and the passkey). Defaults to FACEBOOK_PROXY_BASE_URL
# if that's already set to this same public domain; only set this separately
# if the admin panel is reached at a different host. Must be the exact origin
# the browser uses (e.g. https://fb.example.com, no trailing slash) — WebAuthn
# binds a passkey to one specific origin and refuses to use it anywhere else.
ADMIN_PUBLIC_URL=
